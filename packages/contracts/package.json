{
  "name": "@wealthkart/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "WealthKart Solidity contracts (Foundry).",
  "scripts": {
    "build": "node scripts/forge.mjs build --sizes",
    "test": "node scripts/forge.mjs test -vv",
    "test:ci": "node scripts/forge.mjs test -vv",
    "coverage": "node scripts/forge.mjs coverage --report summary",
    "gas": "node scripts/forge.mjs snapshot",
    "fmt": "node scripts/forge.mjs fmt",
    "fmt:check": "node scripts/forge.mjs fmt --check",
    "lint": "solhint --max-warnings 0 \"src/**/*.sol\" \"script/**/*.sol\" && node scripts/forge.mjs fmt --check",
    "lint:sol": "solhint --max-warnings 0 \"src/**/*.sol\" \"script/**/*.sol\""
  },
  "devDependencies": {
    "solhint": "5.2.0"
  }
}
