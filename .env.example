# Copy to .env.local (never commit real values). Secrets for CI live in GitHub
# environments; web env vars live in Cloudflare Pages settings.

# Contracts (packages/contracts), only needed to deploy from your own machine
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Testnet-only deployer key. Never reuse a key that has held real funds.
DEPLOYER_PRIVATE_KEY=

# Foundry location if forge is not on PATH (e.g. /d/tools/foundry)
FOUNDRY_DIR=

# Web (apps/web), public at build time
# Reown (WalletConnect) project id for Core mobile. Leave empty to hide the QR option.
NEXT_PUBLIC_WC_PROJECT_ID=

# E2E / local chain only. Never set these for a real deploy.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_FACTORY_OVERRIDE=
