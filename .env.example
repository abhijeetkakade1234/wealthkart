# Copy to .env.local (never commit real values). Secrets for CI live in GitHub
# environments; web env vars live in Cloudflare Pages settings.

# Contracts (packages/contracts), only needed to deploy from your own machine
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Testnet-only deployer key. Never reuse a key that has held real funds.
DEPLOYER_PRIVATE_KEY=

# Foundry location if forge is not on PATH (e.g. /d/tools/foundry)
FOUNDRY_DIR=

# Web (apps/web), public at build time
# Reown (WalletConnect) project id for Core mobile. Leave empty to hide the QR option.
NEXT_PUBLIC_WC_PROJECT_ID=

# E2E / local chain only. Never set these for a real deploy.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_FACTORY_OVERRIDE=

# Indexer Worker URL (ADR 0036), e.g. https://wealthkart-indexer.<account>.workers.dev. Empty =
# read all history from the RPC (slower for old circles).
NEXT_PUBLIC_INDEXER_URL=

# Web Push reminders (ADR 0052): the VAPID public key (base64url) matching the indexer's
# VAPID_PUBLIC_KEY. Empty = the app says reminders aren't set up. The private key is only ever a
# Worker secret (`wrangler secret put VAPID_PRIVATE_KEY`), never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Blocks per eth_getLogs call when charts read circle events (ADR 0034). Public Avalanche RPCs
# cap the range at 2048; raise it only for an RPC that allows more.
NEXT_PUBLIC_LOG_CHUNK=
