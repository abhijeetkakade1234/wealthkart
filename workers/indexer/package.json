{
  "name": "@wealthkart/indexer",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker + D1 that caches public WealthKart circle events (ADR 0036).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy",
    "vapid:keys": "node scripts/vapid-keys.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@wealthkart/sdk": "workspace:*",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250927.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
