{
  "name": "@wealthkart/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @wealthkart/rules --filter @wealthkart/sdk build && next build",
    "start": "npx serve out",
    "lint": "eslint && node scripts/check-no-emoji.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:preview": "pnpm build && wrangler pages deploy out --project-name=wealthkart --branch=preview",
    "deploy:prod": "pnpm build && wrangler pages deploy out --project-name=wealthkart --branch=main",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@wealthkart/rules": "workspace:*",
    "@wealthkart/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gsap": "3.15.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "15.5.29",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "viem": "^2.57.19",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "jsdom": "^26.1.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.162.0"
  }
}
