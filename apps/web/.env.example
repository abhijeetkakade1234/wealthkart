# Copy to apps/web/.env.local for `pnpm dev`. Cloudflare Pages sets these per environment
# (Production = main, Preview = dev). See docs/engineering.md §6 and ADR 0051.

# fuji (default) or mainnet. Anything else fails the build.
NEXT_PUBLIC_NETWORK=fuji

# Local chain on your PC: point reads at anvil and give the factory address it printed.
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_FACTORY_OVERRIDE=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Optional: the indexer Worker URL (ADR 0036). Empty = read everything from the RPC.
# NEXT_PUBLIC_INDEXER_URL=
